# Change this before using the application outside local development.
SECRET_KEY=replace-this-with-a-long-random-secret
DATABASE_URL=sqlite:///./chat.db
REDIS_URL=redis://localhost:6379/0
ACCESS_TOKEN_EXPIRE_MINUTES=1440
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional; defaults to the current host and /api/auth/google/callback.
GOOGLE_REDIRECT_URI=
# Set to true when serving over HTTPS.
OAUTH_COOKIE_SECURE=false
# Email verification uses SMTP. For port 587 use STARTTLS; for port 465 use SSL.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_SSL=false
SMTP_STARTTLS=true
# Set to the frontend origin; use http://localhost:8000 for the Docker-built app.
FRONTEND_BASE_URL=http://localhost:5173
