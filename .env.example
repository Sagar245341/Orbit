# Change this before using the application outside local development.
SECRET_KEY=replace-this-with-a-long-random-secret
DATABASE_URL=postgresql+psycopg://orbit:replace-with-a-private-password@localhost:5432/orbit
POSTGRES_DB=orbit
POSTGRES_USER=orbit
POSTGRES_PASSWORD=replace-with-a-private-password
# Existing SQLite database to preserve when migrating to PostgreSQL.
POSTGRES_MIGRATION_SOURCE_URL=sqlite:///./chat.db
REDIS_URL=redis://localhost:6379/0
ACCESS_TOKEN_EXPIRE_MINUTES=1440
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional; defaults to the current host and /api/auth/google/callback.
GOOGLE_REDIRECT_URI=
# Set to true when serving over HTTPS.
OAUTH_COOKIE_SECURE=false
# Email verification uses SMTP. For port 587 use STARTTLS; for port 465 use SSL.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=orbit@localhost.test
SMTP_USE_SSL=false
SMTP_STARTTLS=true
# Set to the frontend origin; use http://localhost:8000 for the Docker-built app.
FRONTEND_BASE_URL=http://localhost:5173
